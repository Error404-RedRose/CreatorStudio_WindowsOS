{
  "name": "@homebridge/node-pty-prebuilt-multiarch",
  "description": "Fork pseudoterminals in Node.JS",
  "author": {
    "name": "Microsoft Corporation"
  },
  "version": "0.15.0",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./typings/node-pty.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge/node-pty-prebuilt-multiarch.git"
  },
  "files": [
    "binding.gyp",
    "lib/**/*.js",
    "!lib/**/*.test.js",
    "scripts/post-install.js",
    "scripts/prebuild.js",
    "src/**/*.{cc,h}",
    "prebuilds/",
    "!prebuilds/**/*.pdb",
    "third_party/",
    "typings/"
  ],
  "homepage": "https://github.com/homebridge/node-pty-prebuilt-multiarch",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.3",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "node-addon-api": "^8.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cross-env": "^5.1.4",
    "eslint": "^10.4.0",
    "globals": "^14.0.0",
    "mocha": "12.0.2",
    "node-gyp": "^13.1.0",
    "ps-list": "^6.0.0",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.1.3": true,
    "es5-ext": false
  }
}